# ======================= Database =======================
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragchat
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://raguser:ragpass@db:5432/ragchat

# ======================= Redis (Upstash free tier or local) =======================
REDIS_URL=redis://redis:6379/0

# ======================= Environment =======================
# "development" = friendly defaults. "production" = the app REFUSES TO START
# unless ADMIN_API_KEY, SESSION_SECRET and CORS_ORIGINS are set properly,
# and /docs is disabled.
APP_ENV=development

# ======================= Security =======================
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sent as the X-Admin-Key header to /v1/ingest, /v1/documents, /v1/admin/usage
ADMIN_API_KEY=
# Signs the session tokens issued by /v1/session (32+ chars in production)
SESSION_SECRET=
# Your real site origin(s), comma separated. Must not be "*" in production.
CORS_ORIGINS=*
# Cloudflare Turnstile (free captcha). Empty = captcha check skipped.
# Secret goes here; the public SITE KEY goes in the widget config.
TURNSTILE_SECRET=

# ======================= LLM providers =======================
# Free dev key: https://console.groq.com
GROQ_API_KEY=
# llama-3.1-8b-instant / llama-3.3-70b-versatile were retired by Groq on
# 2026-08-16; these are Groq's own recommended replacements.
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_COMPLEX_MODEL=openai/gpt-oss-120b

# Paid, recommended for production reliability: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
CLAUDE_COMPLEX_MODEL=claude-sonnet-4-6

# which provider handles which tier: "groq" or "claude"
LLM_FAST_PROVIDER=groq
LLM_COMPLEX_PROVIDER=groq
LLM_TIMEOUT_SECONDS=25

# ======================= Embeddings =======================
# "local" (default): BAAI/bge-small-en-v1.5 baked into the Docker image,
# free forever, no key. "openai"/"voyage" = hosted models (then also set
# EMBEDDING_MODEL and EMBEDDING_DIM to match, and wipe the DB volume).
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
VOYAGE_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# ======================= Branding (this deployment's identity) =======================
# Used in the refusal message, greeting, system prompt and NeMo guard policy.
# Change these (and re-ingest that site's documents) to reuse the bot elsewhere.
BOT_COMPANY_NAME=SmartBusiness Solutions
BOT_TOPICS=Check Printing and Time & Attendance
BOT_COMPANY_SUMMARY=a business software company whose products are Check Printing (prepare, approve and print business checks) and Time and Attendance (employee clock-in/out, geofencing, attendance reports)

# ======================= Retrieval / guardrails =======================
# Below this best-match similarity the bot says "not sure" WITHOUT calling the
# LLM. Watch the "retrieval | ... confidence=" log lines and tune. Too many
# false "not sure" -> lower it; hallucinated off-topic answers -> raise it.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.40

# basic = regex only (free, instant).
# nemo  = regex first, then NVIDIA NeMo Guardrails LLM self-check on every
#         message (free software, but +1 small LLM call per message and it
#         shares your Groq rate limit).
GUARDRAILS_MODE=basic
# LLM used by the NeMo check: any OpenAI-compatible endpoint. Defaults to Groq.
GUARD_LLM_BASE_URL=https://api.groq.com/openai/v1
GUARD_LLM_MODEL=openai/gpt-oss-20b
GUARD_LLM_API_KEY=
GUARD_TIMEOUT_SECONDS=6
# If the NeMo check errors/times out: open = allow message, closed = block it
GUARD_FAIL_MODE=open

# ======================= Rate limits & spend caps =======================
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_IP_PER_MINUTE=30
RATE_LIMIT_IP_PER_DAY=300
RATE_LIMIT_NEW_SESSION_PER_MINUTE=10
# GLOBAL daily caps across all users - the hard stop on your LLM bill.
DAILY_LLM_MESSAGE_CAP=3000
DAILY_TOKEN_CAP=2000000
SESSION_TTL_SECONDS=1800
SESSION_TOKEN_TTL_SECONDS=43200

# ======================= Reranker (optional, off) =======================
RERANK_ENABLED=false
COHERE_API_KEY=

# ======================= Observability (optional, off) =======================
# Langfuse (free cloud tier: https://cloud.langfuse.com , or self-host).
# Set ENABLED=true + both keys to get one trace per chat: question, retrieved
# chunks + confidence, model/tier, tokens, latency, outcome.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# false = send only metadata (no visitor question / answer text) to Langfuse
LANGFUSE_CAPTURE_CONTENT=true

# Production container only: number of uvicorn workers (each loads the
# ~300MB embedding model; use 1 on small hosts)
WEB_CONCURRENCY=2
